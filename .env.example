# Copiar a .env.local para desarrollo, y cargar las mismas en Vercel → Settings → Environment Variables.
# Sin las de Supabase, en desarrollo todo se guarda en .data/db.json.

# Supabase → Project Settings → API
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Clave del panel /admin.html (inventar una larga)
ADMIN_PASSWORD=

# Cualquier texto largo al azar: se mezcla con las IP antes de guardarlas hasheadas
IP_SALT=

# Cloudflare Turnstile (opcional; sin esto no se pide el control anti-robots)
VITE_TURNSTILE_SITEKEY=
TURNSTILE_SECRET=
